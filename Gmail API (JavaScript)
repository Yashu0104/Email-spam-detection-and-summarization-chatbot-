Alternate method for Gmail API integration

function fetchSpamEmails() {
  var threads = GmailApp.search("label:inbox", 0, 6); // or change to label:spam for fetching spam emails
  var messages = GmailApp.getMessagesForThreads(threads);
  
  var emailData = [];
  messages.forEach(thread => {
    thread.forEach(message => {
      emailData.push({
        "from": message.getFrom(),
        "subject": message.getSubject(),
        "body": message.getPlainBody().substring(0, 500) // Limit to 500 chars
      });
    });
  });

  Logger.log(emailData); // Check logs in View > Logs
  return emailData;
}
